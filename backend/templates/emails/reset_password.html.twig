{% extends 'emails/_layout.html.twig' %}
{% block title %}Réinitialisation du mot de passe{% endblock %}
{% block body %}
<h2 style="margin-top:0;">Bonjour {{ user.firstName }},</h2>
<p>Vous avez demandé la réinitialisation de votre mot de passe. Ce lien est à usage unique et expire dans <strong>1 heure</strong>.</p>
<p style="text-align:center;margin:32px 0;">
  <a href="{{ url }}" style="background:#F97316;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-weight:bold;display:inline-block;">Choisir un nouveau mot de passe</a>
</p>
<p style="font-size:13px;color:#64748B;">Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet e-mail.</p>
{% endblock %}
