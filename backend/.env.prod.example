# FitBook – variables de production (alwaysdata).
# À copier sur le serveur dans backend/.env.local (jamais versionné) puis à compléter.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum

# URL publique du site (frontend Angular et API sur la même origine)
DEFAULT_URI=https://fitbook.trinitasnt.alwaysdata.net
FRONTEND_URL=https://fitbook.trinitasnt.alwaysdata.net
CORS_ALLOW_ORIGIN='^https://fitbook\.trinitasnt\.alwaysdata\.net$'

# MySQL alwaysdata : Bases de données > MySQL (utilisateur dédié, différent du compte root).
# La version exacte du serveur est affichée dans l'administration (ex. 8.0.x ou 10.11.x-MariaDB).
DATABASE_URL="mysql://trinitasnt_fitbook:MOT_DE_PASSE@mysql-trinitasnt.alwaysdata.net:3306/trinitasnt_fitbook?serverVersion=8.0.36&charset=utf8mb4"

# Clés JWT générées sur le serveur : php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=remplacer-par-une-passphrase

# E-mails : boîte de test Mailtrap (Email Testing > Inboxes > SMTP Settings).
MAILER_DSN=smtp://IDENTIFIANT:MOT_DE_PASSE@sandbox.smtp.mailtrap.io:2525
MAILER_FROM=no-reply@fitbook.fr
